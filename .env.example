# Копирайте като .env. Празно = стойност по подразбиране от config.py
# По подразбиране всичко е SELF-HOSTED: Kokoro (глас) + mflux/Flux (картини) на вашия Mac.

# ---- Глас ----
TTS_ENGINE=kokoro                # kokoro | say | silent | elevenlabs (облачен)
KOKORO_VOICE=am_michael          # мъжки: am_michael, am_fenrir, am_puck, bm_george, bm_fable, bm_lewis
KOKORO_LANG=a                    # a = американски английски, b = британски (bm_* гласовете)
KOKORO_SPEED=0.95                # <1 = по-бавно и по-драматично

# ---- Картини ----
IMAGE_ENGINE=mflux               # mflux | comfyui | placeholder | fal | replicate (облачни)
MFLUX_MODEL=flux2-klein-4b       # flux2-klein-4b (Apache 2.0, без вход в HF, по-добра консистентност на героите) | schnell (Apache 2.0, изисква hf auth login) | dev (некомерсиален)
MFLUX_STEPS=0                    # 0 = авто: schnell 4, dev 25
MFLUX_QUANTIZE=8                 # 8 = препоръчително; 4 при по-малко RAM; 0 = пълна точност
MFLUX_WIDTH=1920                 # за Ken Burns и thumbnails; при LTX картините са направо в LTX_WIDTH x LTX_HEIGHT
MFLUX_HEIGHT=1088                # кратно на 16
CHARACTER_REFS=1                 # 1 = портрет на всеки герой (characters/) и всяка картина с {герой} от него
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=./comfyui_workflow_api.json
# STYLE_SUFFIX=cinematic film still from a dark medieval fantasy epic, no modern objects, ...   (по подразбиране: филмов кадър)

# ---- Движение ----
MOTION_ENGINE=ltx                # ltx = истинско видео (LTX-2.5, локално, нужна е .venv-ltx – README т.2) | kenburns = картина + zoom/pan
LTX_MODEL=dgrauet/ltx-2.5-mlx-q8 # gated: приемете лиценза в Hugging Face; тегли се ~45 GB
LTX_WIDTH=1024                   # кратно на 64; клиповете се мащабират до 1920x1080
LTX_HEIGHT=576
LTX_SHOT_SEC=4                   # целева дължина на shot (сцена = 2–3 shots с cut-ове)
LTX_MAX_SHOT_SEC=5               # таван (по-дългите shots са по-бавни на секунда видео)
LTX_LOW_RAM=0                    # 1 = стрийминг на модела от диска (за Mac с 16–32 GB)
# LTX_STYLE=Cinematic live-action film footage, natural realistic motion, 35mm film look
# LTX_NEGATIVE=...                 # негативен промпт (NAG); празно = изключено. Вижте config.py
SHOT_CHECK=1                     # автоматична проверка за „дишащ“ zoom / скок
SHOT_RETRIES=1                   # колко пъти се генерира наново shot, който не минава проверката
FILM_GRAIN=4                     # филмово зърно (0 = без)

# ---- Видео ----
VIDEO_RES=1080                   # 1080 | 4k
VIDEO_ENCODER=h264_videotoolbox  # хардуерният енкодер на Apple Silicon
X264_PRESET=medium

# ---- Музика (локален файл/папка, по желание) ----
MUSIC_PATH=                       # напр. music – папка с песни (сменят се с crossfade); кредит за всяка в <песен>.txt
MUSIC_VOLUME=0.16

# ---- Shorts ----
SHORTS_LAYOUT=zoom               # zoom (4:5 изрез на 70% от екрана) | blur (целият кадър, малък) | crop (само центърът)
SHORTS_MAX_SEC=60
SUBS_FONT=Arial

# ---- Облачни (НЕ се ползват, освен ако не ги изберете изрично) ----
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# FAL_KEY=
# REPLICATE_API_TOKEN=
